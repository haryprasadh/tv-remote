<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded notification: connection state + five buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
            <ImageButton
                android:id="@+id/btn_play_pause"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Play or pause"
                android:scaleType="center"
                android:src="@drawable/ic_play_pause"
                android:tint="@color/notification_icon" />
            <ImageButton
                android:id="@+id/btn_vol_down"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Volume down"
                android:scaleType="center"
                android:src="@drawable/ic_volume_down"
                android:tint="@color/notification_icon" />
            <ImageButton
                android:id="@+id/btn_vol_up"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Volume up"
                android:scaleType="center"
                android:src="@drawable/ic_volume_up"
                android:tint="@color/notification_icon" />
            <ImageButton
                android:id="@+id/btn_mute"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Mute"
                android:scaleType="center"
                android:src="@drawable/ic_volume_off"
                android:tint="@color/notification_icon" />
            <ImageButton
                android:id="@+id/btn_power"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Power"
                android:scaleType="center"
                android:src="@drawable/ic_power"
                android:tint="@color/notification_power" />
    </LinearLayout>
</LinearLayout>
